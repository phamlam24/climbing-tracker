---
import type { Climb } from '../table/types';

interface Props {
  climbs: Climb[];
  goal?: number;
}

const { climbs, goal = 20 } = Astro.props;

const V_ORDER = ['VB','V0','V1','V2','V3','V4','V5','V6','V7','V8','V9','V10','V11','V12','V13','V14','V15','V16','V17'];
const v3idx = V_ORDER.indexOf('V3');

const count = climbs.filter(c => V_ORDER.indexOf(c.grade) >= v3idx).length;
const pct = Math.min(100, Math.round((count / goal) * 100));
---

<div class="bg-surface border border-border rounded-lg p-5 min-w-50">
  <p class="text-[0.7rem] font-bold uppercase tracking-widest text-muted mb-1">
    V3+ Ascents
  </p>
  <p class="text-4xl font-bold text-text leading-none mb-3">
    {count}
    <span class="font-normal text-muted">/ {goal}</span>
  </p>
  <div class="h-2 bg-border rounded-full overflow-hidden">
    <div
      class="h-full bg-accent rounded-full transition-[width] duration-500"
      style={`width: ${pct}%`}
      role="progressbar"
      aria-valuenow={pct}
      aria-label="V3+ progress"
    ></div>
  </div>
  <p class="text-right text-[0.7rem] text-muted mt-1">{pct}%</p>
</div>
