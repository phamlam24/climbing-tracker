---
import '../styles/global.css';
import { isAdmin } from '../lib/admin';

interface Props {
  title?: string;
}

const { title = 'Climbing Tracker' } = Astro.props;
const admin = isAdmin(Astro.request);
---

<!doctype html>
<html lang="en" class="macchiato">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>
  <div class="max-w-6xl mx-auto px-6 py-10">

    <header class="mb-10 pb-6 border-b border-border">
      <h1 class="flex items-center gap-3 text-2xl font-bold tracking-tight text-text">
        <a href="/" class="hover:text-accent-h transition-colors">Climbing Tracker</a>
        {admin && (
          <span class="text-[0.65rem] font-bold uppercase tracking-widest bg-accent text-mantle px-2 py-0.5 rounded">
            Admin
          </span>
        )}
      </h1>
      <p class="mt-1 text-sm text-muted">Tailored and over-engineered log for a V2 climber</p>
    </header>

    <slot />

    <footer class="mt-12 pt-4 border-t border-border text-center text-xs text-overlay">
      <slot name="footer-extra" />{Astro.slots.has('footer-extra') ? ' · ' : ''}<a href="https://github.com/phamlam24/climbing-tracker" class="hover:text-muted transition-colors">source / report bugs</a>
    </footer>

  </div>
</body>
</html>
