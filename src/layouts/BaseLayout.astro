---
import '../styles/global.css';
import { isAdmin } from '../lib/admin';
import { AUTH_ORIGIN } from '../lib/authOrigin';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'Climbing Tracker' } = Astro.props;
const admin = await isAdmin(Astro.request, Astro.cookies);

const isLocalhost = Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1';
const redirect = encodeURIComponent(Astro.url.href);
const loginUrl = `${AUTH_ORIGIN}/login?redirect=${redirect}`;
const logoutUrl = `${AUTH_ORIGIN}/logout?redirect=${redirect}`;
---

<!doctype html>
<html lang="en" class="macchiato">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>
  <div class="max-w-6xl mx-auto px-6 py-10">

    <header class="mb-10 pb-6 border-b border-border">
      <h1 class="flex items-center gap-3 text-2xl font-bold tracking-tight text-text">
        <a href="/" class="hover:text-accent-h transition-colors">Climbing Tracker</a>
        {admin && (
          <span class="text-[0.65rem] font-bold uppercase tracking-widest bg-accent text-mantle px-2 py-0.5 rounded">
            Admin
          </span>
        )}
        {!isLocalhost && (
          <a
            href={admin ? logoutUrl : loginUrl}
            class="text-xs font-medium text-muted hover:text-accent-h transition-colors"
          >
            {admin ? 'Log out' : 'Log in'}
          </a>
        )}
      </h1>
      <p class="mt-1 text-sm text-muted">Tailored and over-engineered log for a V2 climber</p>
    </header>

    <slot />

    <Footer loggedIn={admin}>
      <slot name="footer-extra" />
    </Footer>

  </div>
</body>
</html>
