---
import '../styles/global.css';
import { isAdmin } from '../lib/admin';
import { AUTH_ORIGIN } from '../lib/authOrigin';
import SuiteHead from '../components/lampham/SuiteHead.astro';
import SuiteHeader from '../components/lampham/SuiteHeader.astro';
import SuiteFooter from '../components/lampham/SuiteFooter.astro';

interface Props {
  title?: string;
}

const { title = 'Climbing Tracker' } = Astro.props;
const admin = await isAdmin(Astro.request, Astro.cookies);

const isLocalhost = Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1';
const redirect = encodeURIComponent(Astro.url.href);
const loginUrl = `${AUTH_ORIGIN}/login?redirect=${redirect}`;
const logoutUrl = `${AUTH_ORIGIN}/logout?redirect=${redirect}`;
const authHref = isLocalhost ? undefined : admin ? logoutUrl : loginUrl;
---

<!doctype html>
<html lang="en" data-app="climb">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <SuiteHead />
  <title>{title}</title>
</head>
<body>
  <SuiteHeader current="climb" loggedIn={admin} authHref={authHref} width="72rem" />

  <main class="flex-1 w-full max-w-6xl mx-auto px-6 pt-10">
    <header class="mb-10">
      <h1 class="flex items-center gap-3 text-3xl text-text">
        <a href="/" class="text-text hover:text-accent-h hover:no-underline">Climbing Tracker</a>
        {admin && <span class="lp-chip bg-accent-soft text-accent uppercase tracking-widest font-bold">Admin</span>}
      </h1>
      <p class="mt-2 text-muted">Tailored and over-engineered log for a V4 climber</p>
    </header>

    <slot />
  </main>

  <SuiteFooter current="climb">
    <slot name="footer-extra" />
  </SuiteFooter>
</body>
</html>
