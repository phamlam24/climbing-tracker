---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClimbTable from '../components/table/ClimbTable';
import ProjectsSection from '../components/table/ProjectsSection';
import V3PlusProgress from '../components/views/V3PlusProgress.astro';
import GradeDistribution from '../components/views/GradeDistribution.astro';
import PracticeGoals from '../components/views/PracticeGoals.astro';
import GymReviews from '../components/views/GymReviews.astro';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { execSync } from 'node:child_process';
import { isAdmin } from '../lib/admin';
import { LEAD_GRADES, emptyLeadClimb } from '../components/table/types';

const climbs = JSON.parse(await readFile(join(process.cwd(), 'src/data/bouldering.json'), 'utf-8'));
const leadClimbs = JSON.parse(await readFile(join(process.cwd(), 'src/data/lead.json'), 'utf-8'));
const projects = JSON.parse(await readFile(join(process.cwd(), 'src/data/projects.json'), 'utf-8'));

const admin = isAdmin(Astro.request);
const lastUpdated = execSync('git log -1 --format=%cd --date=short').toString().trim();
const lastClimb = climbs.reduce((max: string, c: { date: string }) => c.date > max ? c.date : max, '');
---

<BaseLayout>

  <!-- Mobile layout (< md) -->
  <div class="md:hidden flex flex-col gap-4 mb-8">
    <V3PlusProgress climbs={climbs} goal={10} />
    <PracticeGoals class="w-full" />
    <a href="/blog" class="text-accent hover:text-accent-h text-sm font-medium transition-colors">
      → Gym Reviews
    </a>
  </div>

  <!-- Desktop layout (≥ md) -->
  <div class="hidden md:flex flex-wrap gap-4 mb-10">
    <V3PlusProgress climbs={climbs} goal={10} />
    <GradeDistribution climbs={climbs} />
    <PracticeGoals />
    <GymReviews />
  </div>

  <p class="mb-3 text-[0.7rem] font-bold uppercase tracking-widest text-overlay">
    Boulders
  </p>
  <ClimbTable
    client:load
    initialClimbs={climbs}
    isAdmin={admin}
    dataKey="bouldering"
  />

  <p class="mt-10 mb-3 text-[0.7rem] font-bold uppercase tracking-widest text-overlay">
    Rope
  </p>
  <ClimbTable
    client:load
    initialClimbs={leadClimbs}
    isAdmin={admin}
    dataKey="lead"
    grades={LEAD_GRADES}
    emptyClimbFn={emptyLeadClimb}
  />

  <p class="mt-10 mb-3 text-[0.7rem] font-bold uppercase tracking-widest text-overlay">
    Projects
  </p>
  <ProjectsSection
    client:load
    initialProjects={projects}
    isAdmin={admin}
  />

  <Fragment slot="footer-extra">last climb recorded {lastClimb} · website code last updated {lastUpdated}</Fragment>

</BaseLayout>
