---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClimbTable from '../components/table/ClimbTable';
import ProjectsSection from '../components/table/ProjectsSection';
import V3PlusProgress from '../components/views/V3PlusProgress.astro';
import GradeDistribution from '../components/views/GradeDistribution.astro';
import PracticeGoals from '../components/views/PracticeGoals.astro';
import GymReviews from '../components/views/GymReviews.astro';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { isAdmin } from '../lib/admin';

const climbs = JSON.parse(await readFile(join(process.cwd(), 'src/data/bouldering.json'), 'utf-8'));
const projects = JSON.parse(await readFile(join(process.cwd(), 'src/data/projects.json'), 'utf-8'));

const admin = isAdmin(Astro.request);
---

<BaseLayout>

  <div class="flex flex-wrap gap-4 mb-10">
    <V3PlusProgress climbs={climbs} goal={10} />
    <GradeDistribution climbs={climbs} />
    <PracticeGoals />
    <GymReviews />
  </div>

  <p class="mb-3 text-[0.7rem] font-bold uppercase tracking-widest text-overlay">
    Bouldering Log
  </p>
  <ClimbTable
    client:load
    initialClimbs={climbs}
    isAdmin={admin}
    dataKey="bouldering"
  />

  <p class="mt-10 mb-3 text-[0.7rem] font-bold uppercase tracking-widest text-overlay">
    Projects
  </p>
  <ProjectsSection
    client:load
    initialProjects={projects}
    isAdmin={admin}
  />

</BaseLayout>
