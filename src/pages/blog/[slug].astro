---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const { slug } = Astro.params;
const review = await getEntry('gym-reviews', slug!);

if (!review) return Astro.redirect('/blog');

const { Content } = await render(review);
---

<BaseLayout title={`${review.data.title} — Hanoi Bouldering Gym Reviews`}>

  <a href="/" class="text-xs text-muted hover:text-accent transition-colors mb-6 inline-block">
    ← Main
  </a>

  <p class="mb-1 text-[0.7rem] font-bold uppercase tracking-widest text-overlay">
    Hanoi Bouldering Gym Reviews
  </p>
  <h2 class="text-xl font-bold text-text mb-1">{review.data.title}</h2>
  <p class="text-xs text-overlay mb-8">{review.data.date}</p>

  <article class="prose prose-invert max-w-none
    prose-headings:text-text prose-headings:font-semibold
    prose-p:text-muted
    prose-li:text-muted
    prose-strong:text-text
    prose-a:text-accent prose-a:no-underline hover:prose-a:underline
    prose-blockquote:border-accent prose-blockquote:text-overlay
    prose-code:text-warn prose-code:bg-surface prose-code:rounded prose-code:before:content-none prose-code:after:content-none
    prose-pre:bg-surface prose-pre:border prose-pre:border-border
    prose-hr:border-border">
    <Content />
  </article>

</BaseLayout>
